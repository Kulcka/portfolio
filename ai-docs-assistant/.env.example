# Скопируйте в .env и заполните нужное. Файл .env не коммитится.
# Пустые значения = значения по умолчанию.

# --- Документы и индекс ---
DOCS_DIR=demo_docs
INDEX_DIR=data/index
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_FILE_MB=50

# --- Поиск ---
TOP_K=4
# Порог полноты совпадения (0..1): ниже — бот отвечает «в документах нет».
# Подобран на демо-корпусе командой: python -m docs_assistant eval --tune
MIN_COVERAGE=0.35
# Свой словарь синонимов (одна группа на строку, слова через запятую)
SYNONYMS_FILE=

# --- Тексты ответа ---
COMPANY_NAME=ООО «Ромашка-Логистик»
MANAGER_CONTACT=менеджером по телефону +7 (000) 000-00-00 или support@romashka-logistic.example
REQUIRE_CITATIONS=true

# --- Модель: extractive | openai | yandexgpt | gigachat | fake ---
# extractive — без нейросети и без сети: цитирует найденные строки (для демо и проверки).
LLM_PROVIDER=extractive
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60

# OpenAI-совместимый API: OpenAI, OpenRouter, Ollama, vLLM, LM Studio.
# Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:7b  (ключ не нужен)
# LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YandexGPT (Yandex Cloud AI Studio). Ключ — API-ключ сервисного аккаунта с ролью ai.languageModels.user
YANDEX_API_KEY=
# или IAM-токен (живёт до 12 часов) вместо ключа
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
# yandexgpt-lite | yandexgpt/latest | yandexgpt/rc | aliceai-llm | или полный URI gpt://...
YANDEX_MODEL=yandexgpt-lite
# native — API генерации текста; openai — OpenAI-совместимый API (там же Qwen3, gpt-oss и др.)
YANDEX_API_MODE=native
# false = заголовок x-data-logging-enabled: false (Яндекс не сохраняет запросы)
YANDEX_DATA_LOGGING=false

# GigaChat (Сбер). Ключ авторизации из личного кабинета (строка для Basic-авторизации)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — организации
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Корневой сертификат Минцифры (https://www.gosuslugi.ru/crt), без него TLS не проходит
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer

# --- Эмбеддинги (необязательно; без них работает BM25) ---
# Любой OpenAI-совместимый /embeddings. Примеры:
#   OpenAI: EMBEDDINGS_MODEL=text-embedding-3-small (ключ — OPENAI_API_KEY)
#   Ollama: EMBEDDINGS_BASE_URL=http://localhost:11434/v1  EMBEDDINGS_MODEL=bge-m3
#   Yandex: EMBEDDINGS_BASE_URL=https://ai.api.cloud.yandex.net/v1
#           EMBEDDINGS_MODEL=emb://<каталог>/text-search-doc/latest
#           EMBEDDINGS_QUERY_MODEL=emb://<каталог>/text-search-query/latest
#           EMBEDDINGS_PROJECT=<каталог>  EMBEDDINGS_BATCH_SIZE=1
#   GigaChat: EMBEDDINGS_BASE_URL=https://api.giga.chat/v1  EMBEDDINGS_MODEL=Embeddings
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_QUERY_MODEL=
EMBEDDINGS_PROJECT=
EMBEDDINGS_BATCH_SIZE=16
# Порог косинусной близости, при котором ответ ищется даже без совпадения слов (подбирать замером)
EMBEDDINGS_MIN_SIMILARITY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# id администраторов через запятую (узнать свой id: @userinfobot)
TELEGRAM_ADMIN_IDS=
TELEGRAM_RATE_LIMIT_SECONDS=3

# --- Журнал ---
LOG_LEVEL=INFO
# true — писать тексты вопросов в журнал (по умолчанию нет: там могут быть персональные данные)
LOG_QUESTIONS=false
