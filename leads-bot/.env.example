# Скопируйте в .env и заполните. Файл .env не коммитится и никому не пересылается.
# Достаточно токена одного мессенджера — второй можно оставить пустым.

# --- Telegram -------------------------------------------------------------------------
# Токен от @BotFather (вида 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Куда приходят уведомления о заявках: id группы/чата администратора.
# Узнать: добавьте бота в чат и отправьте /id
TELEGRAM_ADMIN_CHAT_ID=
# Кому ещё доступны /stats и /export в личке с ботом (id через запятую), необязательно
TELEGRAM_ADMIN_USER_IDS=

# --- MAX ------------------------------------------------------------------------------
# Токен бота с платформы MAX для партнёров (business.max.ru), раздел «Чат-боты»
MAX_BOT_TOKEN=
# id чата для уведомлений (узнать: команда /id в чате с ботом)
MAX_ADMIN_CHAT_ID=
MAX_ADMIN_USER_IDS=
# polling — для теста и небольших ботов; webhook — для боевого сервера (рекомендация MAX)
MAX_MODE=polling
# Путь к корневому сертификату Минцифры (Russian Trusted Root CA, .pem/.crt).
# Пусто — если сертификат уже добавлен в системное хранилище. Подробнее — README.
MAX_CA_BUNDLE=
# Только для MAX_MODE=webhook: публичный HTTPS-адрес (порт 443) и секрет 5-256 символов
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# Где слушает сам бот (за nginx): адрес и порт
MAX_WEBHOOK_HOST=127.0.0.1
MAX_WEBHOOK_PORT=8080

# --- Общее ----------------------------------------------------------------------------
DATABASE_PATH=data/leads.sqlite3
CONFIG_PATH=config.yaml
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
